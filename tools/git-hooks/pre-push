#!/usr/bin/env bash
# pre-push —— 本地推送门禁（P2-a：替代 GitHub Actions CI 的方案）
#
# 为什么是本地钩子而不是 GitHub Actions：
#   ① 省流量——依赖已在本机 cargo 缓存，全离线可跑；Actions 每次要在 runner 上
#      重新下载全部依赖（流量与时间都是白花）。
#   ② 本项目反复踩的坑是「cargo test 通过 ≠ 构建通过」（cfg(windows) 缺陷只在
#      非 test 构建/交叉编译暴露，E0433/E0382 出过多次）。mac 侧 ./build-win.sh
#      交叉编译正好在每次 push 前自动兜住这一类。
#   ③ 项目开发就在 mac 宿主提交，钩子装一次全程生效；VM 侧部署另有
#      tools/smoke/deploy-and-smoke.sh 门禁（构建+部署+冒烟）。
#
# 安装（一次性，per-clone）：
#   git config core.hooksPath tools/git-hooks
# 强行跳过（不鼓励）：git push --no-verify
#
# 退出码：0 = 放行；1 = 有检查失败（push 被拒）。

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$repo_root" || exit 1

fail() {
    echo ""
    echo "[pre-push] $*"
    echo "[pre-push] push 已拒绝。修复后重试；确需强行推送用 git push --no-verify。"
    exit 1
}

echo "[pre-push] 1/4 cargo test --workspace（core + 跨平台单测）"
cargo test --workspace 2>&1 | tail -5 || fail "单测失败（见上方输出）"

# core 是**无条件编译**、mac 上完整可见的一半代码，clippy 在这里零假阳性，
# 所以对 core 直接 `-D warnings`（cli 侧 40 条告警几乎全是 cfg(windows) 假阳性：
# 只在 Windows 构造的结构体在 mac 上"从未被构造"，那不是缺陷）。
# ★ 不要对 cli 也开 `-D warnings`——会把一堆假阳性变成推送阻塞，最后只能
#   `--no-verify`，等于把门禁废掉。
echo "[pre-push] 2/4 cargo clippy -p backuprestore-core -- -D warnings"
cargo clippy -p backuprestore-core --all-targets -- -D warnings 2>&1 | tail -5 \
    || fail "core 的 clippy 有真实告警（见上方输出）"

# 错误码是「契约」：docs/ERROR-CODES.md 由 error_code.rs 自动生成。改了码没重生成
# 文档，发布后对照表就是错的。这一步在钩子里重生成一次，脏了就是不同步。
echo "[pre-push] 3/4 错误码清单与代码同步（docs/ERROR-CODES.md）"
if [ -f tools/gen-error-codes.py ]; then
    python3 tools/gen-error-codes.py >/dev/null 2>&1 || fail "错误码清单生成失败"
    if ! git diff --quiet -- docs/ERROR-CODES.md; then
        fail "docs/ERROR-CODES.md 与 error_code.rs 不同步（已重新生成，请 git add 后重新提交再推）"
    fi
else
    echo "[pre-push] 3/4 未找到 tools/gen-error-codes.py：跳过同步检查。"
fi

if [ -x ./build-win.sh ]; then
    echo "[pre-push] 4/4 ./build-win.sh（Windows ARM64 交叉编译，抓 cfg(windows) 缺陷）"
    ./build-win.sh 2>&1 | tail -3 || fail "交叉编译失败（见上方输出）"
else
    echo "[pre-push] 4/4 非 mac 宿主（无 build-win.sh）：跳过交叉编译。"
    echo "[pre-push]     Windows 侧请自行跑 windows/build-windows.ps1 确认构建。"
fi

echo "[pre-push] OK：单测 / core clippy / 错误码同步 / 交叉编译均通过，放行 push。"
