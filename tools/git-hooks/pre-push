#!/usr/bin/env bash
# pre-push —— 本地推送门禁（P2-a：替代 GitHub Actions CI 的方案）
#
# 为什么是本地钩子而不是 GitHub Actions：
#   ① 省流量——依赖已在本机 cargo 缓存，全离线可跑；Actions 每次要在 runner 上
#      重新下载全部依赖（流量与时间都是白花）。
#   ② 本项目反复踩的坑是「cargo test 通过 ≠ 构建通过」（cfg(windows) 缺陷只在
#      非 test 构建/交叉编译暴露，E0433/E0382 出过多次）。mac 侧 ./build-win.sh
#      交叉编译正好在每次 push 前自动兜住这一类。
#   ③ 项目开发就在 mac 宿主提交，钩子装一次全程生效；VM 侧部署另有
#      tools/smoke/deploy-and-smoke.sh 门禁（构建+部署+冒烟）。
#
# 安装（一次性，per-clone）：
#   git config core.hooksPath tools/git-hooks
# 强行跳过（不鼓励）：git push --no-verify
#
# 退出码：0 = 放行；1 = 有检查失败（push 被拒）。

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$repo_root" || exit 1

fail() {
    echo ""
    echo "[pre-push] $*"
    echo "[pre-push] push 已拒绝。修复后重试；确需强行推送用 git push --no-verify。"
    exit 1
}

echo "[pre-push] 1/6 cargo test --workspace（core + 跨平台单测）"
cargo test --workspace 2>&1 | tail -5 || fail "单测失败（见上方输出）"

# core 是**无条件编译**、mac 上完整可见的一半代码，clippy 在这里零假阳性，
# 所以对 core 直接 `-D warnings`（cli 侧 40 条告警几乎全是 cfg(windows) 假阳性：
# 只在 Windows 构造的结构体在 mac 上"从未被构造"，那不是缺陷）。
# ★ 不要对 cli 也开 `-D warnings`——会把一堆假阳性变成推送阻塞，最后只能
#   `--no-verify`，等于把门禁废掉。
echo "[pre-push] 2/6 cargo clippy -p backuprestore-core -- -D warnings"
cargo clippy -p backuprestore-core --all-targets -- -D warnings 2>&1 | tail -5 \
    || fail "core 的 clippy 有真实告警（见上方输出）"

# 错误码是「契约」：docs/ERROR-CODES.md 由 error_code.rs 自动生成。改了码没重生成
# 文档，发布后对照表就是错的。这一步在钩子里重生成一次，脏了就是不同步。
echo "[pre-push] 3/6 错误码清单与代码同步（docs/ERROR-CODES.md）"
if [ -f tools/gen-error-codes.py ]; then
    python3 tools/gen-error-codes.py >/dev/null 2>&1 || fail "错误码清单生成失败"
    if ! git diff --quiet -- docs/ERROR-CODES.md; then
        fail "docs/ERROR-CODES.md 与 error_code.rs 不同步（已重新生成，请 git add 后重新提交再推）"
    fi
else
    echo "[pre-push] 3/6 未找到 tools/gen-error-codes.py：跳过同步检查。"
fi

if [ -x ./build-win.sh ]; then
    echo "[pre-push] 4/6 ./build-win.sh（Windows ARM64 交叉编译，抓 cfg(windows) 缺陷）"
    ./build-win.sh 2>&1 | tail -3 || fail "交叉编译失败（见上方输出）"
else
    echo "[pre-push] 4/6 非 mac 宿主（无 build-win.sh）：跳过交叉编译。"
    echo "[pre-push]     Windows 侧请自行跑 windows/build-windows.ps1 确认构建。"
fi

# Windows **测试**目标：`#[cfg(all(test, windows))]` 那一层此前没有任何入口编译它——
# `cargo test` 在 mac 上不打开 cfg(windows) 文件，`build-win.sh` 走 release 不带 test
# cfg（`boot_entry_fault_tests.rs` 就活在这个交集里，改了没人知道编不编得过）。
# 只编译不运行：产物是 .exe，mac 跑不了；但类型检查与链接都能过，足以兜住这类破窗。
rll="$(rustc --print sysroot)/lib/rustlib/aarch64-apple-darwin/bin/rust-lld"
sdk_ok=1
for d in /Users/x/win-sdk-arm64/um/arm64 /Users/x/win-sdk-arm64/ucrt/arm64 /Users/x/win-sdk-arm64/vc/arm64; do
    [ -d "$d" ] || sdk_ok=0
done
if [ -x "$rll" ] && [ "$sdk_ok" = 1 ]; then
    echo "[pre-push] 5/6 cargo test --no-run --target aarch64-pc-windows-msvc（编译 Windows 测试目标）"
    CARGO_TARGET_AARCH64_PC_WINDOWS_MSVC_LINKER="$rll" \
    RUSTFLAGS="-C target-feature=+crt-static -C link-arg=/LIBPATH:/Users/x/win-sdk-arm64/um/arm64 -C link-arg=/LIBPATH:/Users/x/win-sdk-arm64/ucrt/arm64 -C link-arg=/LIBPATH:/Users/x/win-sdk-arm64/vc/arm64" \
        cargo test --no-run --target aarch64-pc-windows-msvc -p backuprestore-cli 2>&1 | tail -3 \
        || fail "Windows 测试目标编译失败（cfg(test)+cfg(windows) 的代码，见上方输出）"
else
    echo "[pre-push] 5/6 缺 rust-lld 或 Windows SDK libs：跳过 Windows 测试目标编译。"
fi

# 文档链接必须指向**已入库**的文件。本机点得开 ≠ 别人 clone 后打得开：
# `文档索引.md` 曾链接 `AGENTS.md`，而它在 .gitignore 里——本机校验通过、clone 后 404。
# 判据分级（见脚本头注释）：导航文件死链 + 任何位置的「未入库」目标 → 阻塞；
# docs/ 历史归档里的死链只报告（要求历史快照全绿只会逼人篡改历史）。
echo "[pre-push] 6/6 文档链接入库检查（tools/doc/check-doc-links.py）"
if [ -f tools/doc/check-doc-links.py ]; then
    python3 tools/doc/check-doc-links.py --strict > /tmp/br-doc-links.txt 2>&1
    rc=$?
    grep -E '^(MD_TRACKED|LINKS_CHECKED|MISSING|MISSING_NAV|ARCHIVE_MISSING|UNTRACKED)=' \
        /tmp/br-doc-links.txt | tr '\n' ' '
    echo ""
    if [ "$rc" = "2" ]; then
        cat /tmp/br-doc-links.txt
        fail "文档链接检查器故障（rc=2）——这不是「通过」，先修判据本身"
    elif [ "$rc" != "0" ]; then
        grep -E '^ISSUE ' /tmp/br-doc-links.txt | head -20
        fail "有导航文件死链，或链接到未入库文件（见上方 ISSUE 行）"
    fi
else
    echo "[pre-push] 6/6 未找到 tools/doc/check-doc-links.py：跳过。"
fi

echo "[pre-push] OK：单测 / core clippy / 错误码同步 / 交叉编译 / Windows 测试目标编译 / 文档链接入库均通过，放行 push。"
